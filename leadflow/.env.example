# ==============================================================================
# LeadFlow Production Environment Configuration
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=production
CLIENT_URL=http://localhost:5000

# MongoDB Database Connection
# For MongoDB Atlas Free Tier: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/leadflow?retryWrites=true&w=majority
# For Local Development: mongodb://127.0.0.1:27017/leadflow
MONGODB_URI=mongodb://127.0.0.1:27017/leadflow

# Security & Authentication
# Generate a strong 64-character secret using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_64_char_secret_key_in_production

# Token Encryption (AES-256-GCM)
# Must be exactly 32 bytes (64 hexadecimal characters): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Direct SMTP Outreach (Zero Google Cloud Console / Zero OAuth Keys Required!)
# Works with Gmail, Outlook, Yahoo, SendGrid, Amazon SES, Brevo, or custom domain email.
# For Gmail: Use your Gmail address and generate a 16-letter App Password at:
# https://myaccount.google.com/apppasswords (no Google Cloud Project or Client ID/Secret needed)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Google Gemini Flash AI (100% Free Tier)
# Get a free API key at: https://aistudio.google.com/app/apikey
# If omitted, LeadFlow automatically uses the built-in heuristic pitch generator fallback.
GEMINI_API_KEY=

# Outreach Safety & Limits
DAILY_EMAIL_LIMIT=50
