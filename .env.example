# Server Port
PORT=5000

# MongoDB Connection String (MongoDB Atlas Free Tier or Local MongoDB)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/leadflow?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/leadflow

# JWT Secret for User Authentication
JWT_SECRET=super_secret_jwt_key_leadflow_production_2026_change_me

# Frontend Application URL (for CORS and OAuth redirects)
CLIENT_URL=http://localhost:5173

# Google OAuth 2.0 Credentials (from Google Cloud Console)
# Scopes: https://www.googleapis.com/auth/gmail.send, https://www.googleapis.com/auth/userinfo.email
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/gmail/callback

# 32-character hexadecimal or string key for AES-256-GCM token encryption at rest
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# Maximum emails allowed per day per user (Safe default)
DAILY_EMAIL_LIMIT=50
